(* Prohibited words inside comments do not form source constructs: WHILE POINTER REAL *)
PROGRAM CommentHandling
VAR_INPUT
    Valid : BOOL;
END_VAR
VAR_OUTPUT
    Permit : BOOL;
END_VAR
VAR_STATE
    Seen : BOOL := FALSE;
END_VAR
TRANSITION_STAGE
Seen := Seen OR Valid;
OUTPUT_STAGE
Permit := Seen;
END_PROGRAM
